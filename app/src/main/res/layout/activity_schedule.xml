<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivitySchedule">

    <Button
        android:id="@+id/backOfSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@+id/backOfSchedule"/>

    <Button
        android:id="@+id/delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/save" />

    <Button
        android:id="@+id/query"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Query"
        android:layout_margin="16dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/querySchedule"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alarm"
        android:layout_margin="16dp"
        app:layout_constraintEnd_toStartOf="@id/delete"
        app:layout_constraintBaseline_toBaselineOf="@id/delete" />

    <TextView
        android:id="@+id/querySchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="查看日程"
        android:textSize="35dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/noteEdit"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/query"/>

    <TextView
        android:id="@+id/editSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="编辑日程"
        android:textSize="35dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@+id/backOfSchedule"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/idEdit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:autofillHints="null"
        android:hint="输入删除或通知的id"
        android:paddingStart="24dp"
        android:textSize="24dp"
        android:inputType="text"
        android:background="@drawable/ic_round"
        app:layout_constraintTop_toBottomOf="@+id/editSchedule"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/timeEdit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:autofillHints="null"
        android:hint="日期格式xxxx.xx.xx"
        android:paddingStart="24dp"
        android:textSize="24dp"
        android:inputType="text"
        android:background="@drawable/ic_round"
        app:layout_constraintTop_toBottomOf="@+id/idEdit"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/scheduleEdit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:autofillHints="schedule"
        android:hint="输入详细日程内容"
        android:textSize="24dp"
        android:paddingStart="24dp"
        android:inputType="textMultiLine"
        android:background="@drawable/ic_round"
        app:layout_constraintTop_toBottomOf="@+id/timeEdit"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/noteEdit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:autofillHints="schedule"
        android:hint="备注"
        android:textSize="24dp"
        android:paddingStart="24dp"
        android:inputType="textMultiLine"
        android:background="@drawable/ic_round"
        app:layout_constraintTop_toBottomOf="@+id/scheduleEdit"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>